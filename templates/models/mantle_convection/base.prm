# Teaching template for ordinary geologists: beginner 2-D box convection.
# This is not a final research model.
# Needs verification with ASPECT 3.0.0 before production use.
#
# Local structure source: cookbooks/convection-box/convection-box.prm
# Geological meaning: a square mantle-like box heated from below and cooled from above.

set Dimension                              = 2
set Use years in output instead of seconds = false
set End time                               = 0.5
set Output directory                       = output-beginner-2d-box-convection
set Pressure normalization                 = surface
set Surface pressure                       = 0

# Geological domain: a simple 2-D Cartesian box.
# TODO: change X/Y extent only after deciding whether this is nondimensional or SI.
subsection Geometry model
  set Model name = box

  subsection Box
    set X extent = 1
    set Y extent = 1
  end
end

# Starting temperature: linear cooling upward plus a small perturbation.
# This perturbation lets convection start from an unstable thermal state.
subsection Initial temperature model
  set Model name = function

  subsection Function
    set Variable names      = x,z
    set Function constants  = p=0.01, L=1, pi=3.1415926536, k=1
    set Function expression = (1.0-z) - p*cos(k*pi*x/L)*sin(pi*z)
  end
end

# Thermal boundaries: hot bottom, cold top, insulated sides.
subsection Boundary temperature model
  set Fixed temperature boundary indicators = bottom, top
  set List of model names = box

  subsection Box
    set Bottom temperature = 1
    set Left temperature   = 0
    set Right temperature  = 0
    set Top temperature    = 0
  end
end

# Mechanical boundaries: free slip on all sides.
subsection Boundary velocity model
  set Tangential velocity boundary indicators = left, right, bottom, top
end

# Gravity drives buoyancy vertically.
subsection Gravity model
  set Model name = vertical

  subsection Vertical
    set Magnitude = 1e4
  end
end

# Simple nondimensional material parameters.
# TODO: replace with SI Earth values only after changing geometry, time, and temperature units consistently.
subsection Material model
  set Model name = simple

  subsection Simple model
    set Reference density             = 1
    set Reference specific heat       = 1
    set Reference temperature         = 0
    set Thermal conductivity          = 1
    set Thermal expansion coefficient = 1
    set Viscosity                     = 1
  end
end

# Physical approximation: incompressible Boussinesq convection.
subsection Formulation
  set Formulation = Boussinesq approximation
end

# Mesh: coarse beginner resolution, no adaptive refinement.
subsection Mesh refinement
  set Initial global refinement          = 4
  set Initial adaptive refinement        = 0
  set Time steps between mesh refinement = 0
end

# Outputs: statistics plus visualization for temperature and velocity interpretation.
subsection Postprocess
  set List of postprocessors = velocity statistics, temperature statistics, heat flux statistics, visualization

  subsection Visualization
    set Time between graphical output = 0.01
  end
end

subsection Solver parameters
  set Temperature solver tolerance = 1e-10
end
